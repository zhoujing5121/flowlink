{
  "name": "flowlink",
  "version": "0.1.0",
  "private": true,
  "description": "FlowLink — Electron 录制回放自动化工具",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "dev": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1 -Dev",
    "package": "npm run build && electron-packager . FlowLink --platform=win32 --arch=x64 --out=release --overwrite && node package.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.1",
    "playwright-core": "1.64.1",
    "undici": "8.12.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^45.2.3",
    "esbuild": "^0.24.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "esbuild@0.24.2": true,
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  }
}
